NODE_ENV=development
PORT=3000

# PostgreSQL connection string (Prisma).
# PostgreSQL via URL: postgresql://USER:PASSWORD@HOST:5432/sna3ti?schema=public
DATABASE_URL=

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1h

# Allowed browser origin(s) for the SPA (comma-separated). Example: http://localhost:5500
CORS_ORIGIN=http://localhost:5500

# bcrypt cost factor
BCRYPT_ROUNDS=12