NODE_ENV=development
PORT=3000

# PostgreSQL connection string (Prisma).
# PostgreSQL via URL: postgresql://USER:PASSWORD@HOST:5432/sna3ti?schema=public
DATABASE_URL=

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1h

# Allowed browser origin(s) for the SPA (comma-separated). Example: http://localhost:5500
CORS_ORIGIN=http://localhost:5500

# bcrypt cost factor
BCRYPT_ROUNDS=12

# ---------------------------------------------------------------------------
# FRONTEND safe mock-fallback gating (REQ 46-56).
# These two values are READ BY THE BROWSER at runtime (exposed as `window`
# globals by the SPA), NOT by the Express server. They are listed here purely
# as deployment documentation for whoever configures the frontend build/host.
#
#   SNA3TI_ENV                   = development | production | test
#       Controls whether the UI may EVER show demo/mock data.
#       Defaults to "development" when unset.
#
#   SNA3TI_ALLOW_MOCK_FALLBACK   = true | false
#       Development-only opt-in for demo data when the API is unavailable.
#
# SAFETY RULES (enforced in js/fallback-gate.js -> canUseMockFallback()):
#   * Production ALWAYS forbids mock fallback, regardless of this flag —
#     an API failure is an error/offline state, never silent demo data.
#   * Development allows demo fallback ONLY when explicitly set to true.
#   * A successful empty response ("[]") is an empty state, never an error.
# ---------------------------------------------------------------------------
SNA3TI_ENV=development
SNA3TI_ALLOW_MOCK_FALLBACK=false