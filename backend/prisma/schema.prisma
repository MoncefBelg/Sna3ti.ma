generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums — closed value sets mirrored from the Sna3tiData mock facade.
// ---------------------------------------------------------------------------

enum AdminRole {
  super_admin
  admin
  finance
  moderator
  support
}

enum UserStatus {
  active
  inactive
  suspended
}

// Authentication-level role for regular platform users (see User.role).
enum UserRole {
  user
  professional
  admin
  super_admin
  moderator
  finance
  support
}

enum ProfessionalStatus {
  pending
  active
  suspended
  rejected
}

enum VerificationLevel {
  join
  identity
  professionnel
  plan
}

enum VerificationStatus {
  pending
  approved
  rejected
  needs_info
}

enum PaymentMethod {
  bank_transfer
  card
  cash
  paypal
}

enum PaymentStatus {
  pending
  confirmed
  rejected
  needs_info
}

enum SubscriptionStatus {
  pending
  active
  expired
  cancelled
}

enum ReviewStatus {
  published
  hidden
  flagged
}

enum ReportStatus {
  new
  under_review
  resolved
  ignored
}

enum SupportStatus {
  open
  pending
  resolved
  closed
}

// Sna3ti Match — "Trouve-moi un artisan de confiance" (req N).
enum MatchStatus {
  new
  reviewing
  artisan_contacted
  price_received
  price_sent
  customer_accepted
  customer_rejected
  matched
  completed
  cancelled
}

// ---------------------------------------------------------------------------
// RBAC
// ---------------------------------------------------------------------------

model Role {
  id          String   @id
  label       String
  color       String   @default("gray")
  permissions Json
}

model AdminUser {
  id         String    @id
  name       String
  email      String    @unique
  password   String
  role       String
  status     String    @default("active")
  lastLogin  DateTime?
  refreshAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([role])
}

// Sequence-backed opaque-ID generation. Each row tracks the next value for a
// given entity prefix (USR, PRO, PAY, ...). Values are monotonically
// increasing and never reused, so ids survive deletion and are never derived
// from the current row count.
model IdSequence {
  prefix String @id // e.g. "USR", "PRO", "PAY"
  value  Int    @default(10000)
}

model AuditLog {
  id         String   @id // append-only; no update/delete allowed via API
  adminId    String?
  action     String   // e.g. VERIFICATION_APPROVED, PAYMENT_CONFIRMED
  entityType String
  entityId   String?
  reason     String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([adminId])
  @@index([entityType, entityId])
}

// ---------------------------------------------------------------------------
// Catalog (categories / regions / cities / plans)
// ---------------------------------------------------------------------------

model Category {
  id          String   @id
  code        String   @unique
  icon        String?
  order       Int      @default(0)
  active      Boolean  @default(true)
  label       Json
  services    Json     @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Region {
  id        String   @id
  name      Json
  slug      String   @unique
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model City {
  id        String  @id
  name      Json
  regionId  String
  createdAt DateTime @default(now())

  @@index([regionId])
}

model Plan {
  id          String          @id // PLAN-FREE | PLAN-VERIFIED | PLAN-GOLD
  code        String          @unique // free | verified | gold
  name        String
  price       Int
  currency    String          @default("MAD")
  active      Boolean         @default(true)
  limits      Json            @default("{}")
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

// ---------------------------------------------------------------------------
// Marketplace
// ---------------------------------------------------------------------------

model User {
  id           String     @id // opaque USR-xxxxx, never parsed as int
  firstName    String
  lastName     String
  name         String // "${firstName} ${lastName}" convenience
  email        String?    @unique
  phone        String     @unique
  passwordHash String // bcrypt only — passwords never stored in plaintext
  role         UserRole   @default(user)
  cityId       String?
  status       UserStatus @default(active)
  professionId String?
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([role])
  @@index([cityId])
}

model Professional {
  id                  String   @id
  userId              String?
  categoryId          String?
  professionId        String?
  name                String
  job                 String
  city                String?
  cityId              String?
  area                String?
  neighborhood        String?
  phone               String?
  email               String?
  whatsapp            String?
  description         String?
  experience          String?
  status              ProfessionalStatus   @default(pending)
  available           Boolean              @default(true)
  distance            Float?
  media               Json                 @default("[]")
  services            Json                 @default("[]")
  serviceAreas        Json                 @default("[]")
  languages           Json                 @default("[]")
  identityStatus      String               @default("pending")
  professionStatus    String               @default("pending")
  verificationStatus  String               @default("pending")
  verified            Boolean              @default(false)
  planEligible        Boolean              @default(false)
  subscriptionPlanId  String?
  subscriptionStatus  String               @default("none")
  subscriptionExpiresAt DateTime?
  package             String               @default("free")
  rating              Float?
  reviewsCount        Int                  @default(0)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([categoryId])
  @@index([status])
  @@index([verificationStatus])
}

model Subscription {
  id            String             @id
  professionalId String            @unique
  planId        String?
  planName      String             @default("GRATUIT")
  status        SubscriptionStatus @default(pending)
  paymentStatus String             @default("pending") // pending | confirmed
  price         Int                @default(0)
  currency      String             @default("MAD")
  since         DateTime?
  renewal       DateTime?
  activeAt      DateTime?
  startedAt     DateTime?
  expiresAt     DateTime?
  renewalAt     DateTime?
  cancelledAt   DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
}

model Payment {
  id             String        @id
  reference      String        @unique
  professionalId String
  subscriptionId String?
  planName       String
  amount         Int
  method         PaymentMethod @default(bank_transfer)
  status         PaymentStatus @default(pending)
  bankRef        String?
  receipt        String?
  date           DateTime      @default(now())
  rejectionReason String?
  infoRequested  String?
  reviewedById   String?
  reviewedAt     DateTime?
  verificationRequestId String? // linked plan request (level = plan)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([professionalId])
  @@index([status])
}

model VerificationRequest {
  id             String             @id
  professionalId String
  level          VerificationLevel
  planId         String?
  requestedPlan  String?
  price          Int?
  status         VerificationStatus @default(pending)
  priority       String             @default("medium")
  reason         String?
  infoRequested  String?
  submitted      DateTime?          @default(now())
  reviewedAt     DateTime?
  reviewerId     String?
  reviewerName   String?
  paymentId      String?            // set when the plan request is paid via bank transfer
  history        Json               @default("[]")
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([professionalId])
  @@index([paymentId])
  @@index([status])
}

model VerificationDocument {
  id                   String   @id // opaque VD-xxxxx
  verificationRequestId String  @unique
  professionalId       String
  type                 String // cni | patente | rib | photo | attestation | ...
  fileName             String
  fileUrl              String
  mimeType             String?
  size                 Int?
  verified             Boolean  @default(false)
  notes                String?
  uploadedAt           DateTime @default(now())
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([professionalId])
  @@index([type])
}

model Review {
  id             String        @id
  professionalId String
  userId         String?
  customer       String
  rating         Int
  comment        String?
  status         ReviewStatus  @default(published)
  flaggedReason  String?
  flaggedReporter String?
  flaggedDate    DateTime?
  date           DateTime      @default(now())
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([professionalId])
  @@index([status])
}

model Report {
  id             String            @id
  professionalId String
  reporter       String?
  reportedBy     String?
  reason         String
  type           String?
  priority       String            @default("medium")
  description    String?
  status         ReportStatus      @default(new)
  warnReason     String?
  assignedTo     String?
  resolvedAt     DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([professionalId])
  @@index([status])
}

// Sna3ti Match request — a customer asks to be matched with a trusted
// artisan. WhatsApp is a notification channel only; the request itself is
// ALWAYS persisted first (source of truth). Prices are entered by admins only,
// never auto-generated. Photos are stored privately and served via guarded
// admin endpoints only.
model MatchRequest {
  id                String          @id                // opaque REQ-xxxxx
  name              String
  phone             String
  whatsapp          String?
  city              String
  area              String?
  service           String          // service slug, or "autre"
  otherService      String?
  description       String?
  preferredContact  String          @default("both")   // phone | whatsapp | both
  preferredDate     DateTime?
  status            MatchStatus     @default(new)
  artisanName       String?
  artisanPhone      String?
  notificationStatus Json            @default("{}")     // { whatsapp: "sent"|"failed"|"pending" }
  // Prices — entered by admin only, never auto-generated.
  artisanPrice      Int?
  customerPrice     Int?
  commission        Int?
  adminNote         String?
  whatsappRetryAt   DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  photos            MatchPhoto[]

  @@index([status])
  @@index([createdAt])
}

model MatchPhoto {
  id              String        @id   // opaque PH-xxxxx
  matchRequestId  String
  fileName        String
  fileUrl         String
  mimeType        String?
  size            Int?
  createdAt       DateTime      @default(now())

  request         MatchRequest  @relation(fields: [matchRequestId], references: [id], onDelete: Cascade)

  @@index([matchRequestId])
}

model SupportTicket {
  id             String        @id
  professionalId String?
  user           String?
  subject        String
  message        String
  status         SupportStatus @default(open)
  priority       String        @default("medium")
  assignedTo     String?
  history        Json          @default("[]")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status])
}

model Notification {
  id         String    @id // opaque NT-xxxxx
  userId     String?   // target user
  type       String    @default("system")
  title      String?
  message    String
  entityType String?
  entityId   String?
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([readAt])
}

model LegalDocument {
  id        String   @id // e.g. terms-en | privacy-fr | about-ar
  type      String   // terms | privacy | about
  language  String   // en | fr | ar
  title     String
  content   String
  version   Int      @default(1)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([type, language])
}