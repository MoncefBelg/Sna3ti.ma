generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums — closed value sets mirrored from the Sna3tiData mock facade.
// ---------------------------------------------------------------------------

enum AdminRole {
  super_admin
  admin
  finance
  moderator
  support
}

enum UserStatus {
  active
  inactive
  suspended
}

// Authentication-level role for regular platform users (see User.role).
enum UserRole {
  user
  professional
  admin
  super_admin
  moderator
  finance
  support
}

enum ProfessionalStatus {
  pending
  active
  suspended
  rejected
}

enum VerificationLevel {
  join
  identity
  professionnel
  plan
}

enum VerificationStatus {
  pending
  approved
  rejected
  needs_info
}

enum PaymentMethod {
  bank_transfer
  card
  cash
  paypal
}

enum PaymentStatus {
  pending
  confirmed
  rejected
  needs_info
}

enum SubscriptionStatus {
  pending
  active
  expired
  cancelled
}

// Immutable financial-history events (REQ 58-D). Type is closed:
// activation (a new paid period) and renewal (an appended paid period).
enum BillingTransactionType {
  activation
  renewal
}

// Minimal lifecycle for a historical paid period. `active` = the period is the
// current/entitlement period; `expired` = the paid period has elapsed (or was
// replaced); `cancelled` = the entitlement was revoked early. Expiry is NOT a
// new financial event — it only re-labels the historical record.
enum BillingTransactionStatus {
  active
  expired
  cancelled
}

enum ReviewStatus {
  pending
  published
  hidden
  flagged
}

// WhatsApp/phone contact interaction (req contact-trust). Channels are closed
// sets; "WHATSAPP" is the only channel that can ever unlock review eligibility.
enum InteractionChannel {
  WHATSAPP
  PHONE
}

enum InteractionSource {
  PROFILE
  SEARCH
  MATCH
}

enum InteractionStatus {
  TRACKED
  CONFIRMED_CONTACT
  FLAGGED
  REJECTED
}

enum ReportStatus {
  new
  under_review
  resolved
  ignored
}

enum SupportStatus {
  open
  pending
  resolved
  closed
}

// Sna3ti Match — "Trouve-moi un artisan de confiance" (req N).
enum MatchStatus {
  new
  reviewing
  artisan_contacted
  price_received
  price_sent
  customer_accepted
  customer_rejected
  matched
  completed
  cancelled
}

// Account-free artisan subscription requests. approved/rejected are reserved
// for the upcoming admin approval flow; intake only ever creates pending.
enum ProfessionalRequestStatus {
  pending
  approved
  rejected
}

// ---------------------------------------------------------------------------
// RBAC
// ---------------------------------------------------------------------------

model Role {
  id          String   @id
  label       String
  color       String   @default("gray")
  permissions Json
}

model AdminUser {
  id         String    @id
  name       String
  email      String    @unique
  password   String
  role       String
  status     String    @default("active")
  lastLogin  DateTime?
  refreshAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([role])
}

// Sequence-backed opaque-ID generation. Each row tracks the next value for a
// given entity prefix (USR, PRO, PAY, ...). Values are monotonically
// increasing and never reused, so ids survive deletion and are never derived
// from the current row count.
model IdSequence {
  prefix String @id // e.g. "USR", "PRO", "PAY"
  value  Int    @default(10000)
}

model AuditLog {
  id         String   @id // append-only; no update/delete allowed via API
  adminId    String?
  action     String   // e.g. VERIFICATION_APPROVED, PAYMENT_CONFIRMED
  entityType String
  entityId   String?
  reason     String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([adminId])
  @@index([entityType, entityId])
}

// ---------------------------------------------------------------------------
// Catalog (categories / regions / cities / plans)
// ---------------------------------------------------------------------------

model Category {
  id          String   @id
  code        String   @unique
  icon        String?
  order       Int      @default(0)
  active      Boolean  @default(true)
  label       Json
  services    Json     @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Region {
  id        String   @id
  name      Json
  slug      String   @unique
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model City {
  id        String  @id
  name      Json
  regionId  String
  createdAt DateTime @default(now())

  @@index([regionId])
}

model Plan {
  id          String          @id // PLAN-FREE | PLAN-VERIFIED | PLAN-GOLD
  code        String          @unique // free | verified | gold
  name        String
  price       Int
  currency    String          @default("MAD")
  active      Boolean         @default(true)
  limits      Json            @default("{}")
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

// ---------------------------------------------------------------------------
// Marketplace
// ---------------------------------------------------------------------------

model User {
  id           String     @id // opaque USR-xxxxx, never parsed as int
  firstName    String
  lastName     String
  name         String // "${firstName} ${lastName}" convenience
  email        String?    @unique
  phone        String     @unique
  passwordHash String // bcrypt only — passwords never stored in plaintext
  role         UserRole   @default(user)
  cityId       String?
  status       UserStatus @default(active)
  professionId String?
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([role])
  @@index([cityId])
}

model Professional {
  id                  String   @id
  userId              String?
  categoryId          String?
  professionId        String?
  name                String
  job                 String
  city                String?
  cityId              String?
  area                String?
  neighborhood        String?
  phone               String?
  email               String?
  whatsapp            String?
  description         String?
  experience          String?
  status              ProfessionalStatus   @default(pending)
  available           Boolean              @default(true)
  distance            Float?
  media               Json                 @default("[]")
  services            Json                 @default("[]")
  serviceAreas        Json                 @default("[]")
  languages           Json                 @default("[]")
  identityStatus      String               @default("pending")
  professionStatus    String               @default("pending")
  verificationStatus  String               @default("pending")
  verified            Boolean              @default(false)
  planEligible        Boolean              @default(false)
  subscriptionPlanId  String?
  subscriptionStatus  String               @default("none")
  subscriptionExpiresAt DateTime?
  package             String               @default("free")
  rating              Float?
  reviewsCount        Int                  @default(0)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([categoryId])
  @@index([status])
  @@index([verificationStatus])
}

model Subscription {
  id            String             @id
  professionalId String            @unique
  planId        String?
  planName      String             @default("GRATUIT")
  status        SubscriptionStatus @default(pending)
  paymentStatus String             @default("pending") // pending | confirmed
  price         Int                @default(0)
  currency      String             @default("MAD")
  since         DateTime?
  renewal       DateTime?
  activeAt      DateTime?
  startedAt     DateTime?
  expiresAt     DateTime?
  renewalAt     DateTime?
  cancelledAt   DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
}

// REQ 58-D — Immutable, append-only paid-period history.
//
// Business intent: a Payment is the monetary workflow record; a Subscription
// is the CURRENT entitlement state (one per professional, overwritten on
// renew); a BillingTransaction is the immutable financial ledger preserving
// EVERY paid period. Renewal NEVER overwrites a past transaction — it APPENDS a
// new one. Expiry/downgrade never create a new financial event; they only
// re-label the historical record's status.
//
// Immutability: there is NO update/delete route or admin action that edits or
// removes these rows. `paymentId` is UNIQUE at the DB level so a repeated
// confirmation can never create duplicate transactions.
model BillingTransaction {
  id             String                 @id // BT-xxxxx
  type           BillingTransactionType
  professionalId String
  paymentId      String?                @unique // null for renewal (no new payment)
  subscriptionId String
  planId         String?
  planName       String
  amount         Int
  currency       String                 @default("MAD")
  periodStartAt  DateTime
  periodEndAt    DateTime
  actorId        String?                // reviewer/actor, from server context
  actorName      String?
  status         BillingTransactionStatus @default(active)
  createdAt      DateTime               @default(now())

  @@index([professionalId])
  @@index([planId])
  @@index([status])
  @@index([createdAt])
}

model Payment {
  id             String        @id
  reference      String        @unique
  professionalId String
  subscriptionId String?
  planName       String
  amount         Int
  // REQ 58-A — currency is SERVER-authoritative (plan currency, MAD); the
  // client never supplies it for normal payment creation.
  currency       String        @default("MAD")
  method         PaymentMethod @default(bank_transfer)
  status         PaymentStatus @default(pending)
  bankRef        String?
  receipt        String?
  // REQ 58-C — proof-submission metadata. `receipt`/`bankRef` remain plain,
  // sanitized reference strings (never treated as verified uploaded files).
  proofSubmittedAt DateTime?
  proofNote       String?
  date           DateTime      @default(now())
  rejectionReason String?
  infoRequested  String?
  reviewedById   String?
  reviewedAt     DateTime?
  verificationRequestId String? // linked plan request (level = plan)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([professionalId])
  @@index([status])
}

model VerificationRequest {
  id             String             @id
  professionalId String
  level          VerificationLevel
  planId         String?
  requestedPlan  String?
  price          Int?
  status         VerificationStatus @default(pending)
  priority       String             @default("medium")
  reason         String?
  infoRequested  String?
  submitted      DateTime?          @default(now())
  reviewedAt     DateTime?
  reviewerId     String?
  reviewerName   String?
  paymentId      String?            // set when the plan request is paid via bank transfer
  history        Json               @default("[]")
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([professionalId])
  @@index([paymentId])
  @@index([status])
}

model VerificationDocument {
  id                   String   @id // opaque VD-xxxxx
  verificationRequestId String  @unique
  professionalId       String
  type                 String // cni | patente | rib | photo | attestation | ...
  fileName             String
  fileUrl              String
  mimeType             String?
  size                 Int?
  verified             Boolean  @default(false)
  notes                String?
  uploadedAt           DateTime @default(now())
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([professionalId])
  @@index([type])
}

model Review {
  id             String        @id
  professionalId String
  userId         String?
  customer       String
  rating         Int
  comment        String?
  status         ReviewStatus  @default(pending)
  verifiedContact Boolean      @default(false) // true only for validated WhatsApp contacts
  interactionId  String?       // linked ProfessionalContactInteraction (one review per contact)
  riskScore      Int           @default(0) // 0-100; computed server-side at creation
  reviewerName   String?       // reviewer name captured on WhatsApp submissions (REQ 62)
  reviewerContact String?      // reviewer WhatsApp number captured on submission (REQ 62, admin-only)
  reviewSource   String        @default("app") // app | whatsapp | admin
  flaggedReason  String?
  flaggedReporter String?
  flaggedDate    DateTime?
  date           DateTime      @default(now())
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([professionalId])
  @@index([status])
  @@index([interactionId])
}

// A contact interaction is the server-side record of a customer reaching an
// artisan (WhatsApp / phone) from the marketplace. It is the ONLY source of
// proof used to unlock a review: eligibility requires an authenticated customer,
// channel WHATSAPP, a positive confirmation, and a 48h cooling-off period. The
// customer id is checked server-side; anonymous (null) interactions are
// tracked for analytics but can never unlock a review.
model ProfessionalContactInteraction {
  id                     String            @id // opaque INT-xxxxx, never parsed as int
  customerId             String?           // null = anonymous (tracked, never review-eligible)
  professionalId         String
  channel                InteractionChannel @default(WHATSAPP)
  source                 InteractionSource  @default(PROFILE)
  status                 InteractionStatus  @default(TRACKED)
  riskScore              Int                @default(0) // 0-100 (see evaluation signals)
  riskFlags              Json               @default("[]")
  lastContactAt          DateTime           @default(now())
  reviewEligibleAt       DateTime?          // createdAt + 48h cooling-off
  customerConfirmed      Boolean            @default(false)
  customerConfirmedAt    DateTime?
  customerReportedService String?           // "yes" | "no" | "in_progress" (customer self-report)
  reviewId               String?            // set once a review is created (one review max)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  @@unique([customerId, professionalId]) // one interaction session per customer+pro
  @@index([professionalId])
  @@index([status])
  @@index([customerId])
  @@index([createdAt])
}

model Report {
  id             String            @id
  professionalId String
  reporter       String?
  reportedBy     String?
  reason         String
  type           String?
  priority       String            @default("medium")
  description    String?
  status         ReportStatus      @default(new)
  warnReason     String?
  assignedTo     String?
  resolvedAt     DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([professionalId])
  @@index([status])
}

// Sna3ti Match request — a customer asks to be matched with a trusted
// artisan. WhatsApp is a notification channel only; the request itself is
// ALWAYS persisted first (source of truth). Prices are entered by admins only,
// never auto-generated. Photos are stored privately and served via guarded
// admin endpoints only.
model MatchRequest {
  id                String          @id                // opaque REQ-xxxxx
  name              String
  phone             String
  whatsapp          String?
  city              String
  area              String?
  service           String          // service slug, or "autre"
  otherService      String?
  description       String?
  preferredContact  String          @default("both")   // phone | whatsapp | both
  preferredDate     DateTime?
  status            MatchStatus     @default(new)
  artisanName       String?
  artisanPhone      String?
  notificationStatus Json            @default("{}")     // { whatsapp: "sent"|"failed"|"pending" }
  // Prices — entered by admin only, never auto-generated.
  artisanPrice      Int?
  customerPrice     Int?
  commission        Int?
  adminNote         String?
  whatsappRetryAt   DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  photos            MatchPhoto[]

  @@index([status])
  @@index([createdAt])
}

model MatchPhoto {
  id              String        @id   // opaque PH-xxxxx
  matchRequestId  String
  fileName        String
  fileUrl         String
  mimeType        String?
  size            Int?
  createdAt       DateTime      @default(now())

  request         MatchRequest  @relation(fields: [matchRequestId], references: [id], onDelete: Cascade)

  @@index([matchRequestId])
}

model SupportTicket {
  id             String        @id
  professionalId String?
  user           String?
  subject        String
  message        String
  status         SupportStatus @default(open)
  priority       String        @default("medium")
  assignedTo     String?
  history        Json          @default("[]")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status])
}

// Account-free artisan onboarding request (REQ 53 — intake).
// Backend-authoritative: status is always "pending" at creation, subscription
// activation and marketplace publication are admin-only actions. The plan is
// resolved server-side against the active plan catalogue (never from client
// input), and `id` doubles as the reference shown to the artisan.
model ProfessionalRequest {
  id                String                       @id // opaque ARQ-xxxxx
  firstName         String
  lastName          String
  phone             String
  profession        String                       // metier slug, or "autre"
  otherService      String?
  city              String                       // city slug
  cityLabel         String?                      // readable label for admin/WhatsApp
  description       String?
  price             Int?
  priceUnit         String?
  media             Json                         @default("[]") // profile photo + échantillons (photos/videos)
  planId            String?                      // resolved server-side
  planCode          String?                      // free | verified | gold
  planName          String?
  planPrice         Int?                         // server-side plan price (MAD)
  status            ProfessionalRequestStatus    @default(pending)
  notificationStatus Json                       @default("{}") // { whatsapp: sent|failed|pending }
  whatsappRetryAt   DateTime?
  reason            String?                      // rejection reason (admin)
  reviewedAt        DateTime?                    // last admin decision time
  reviewerId        String?                      // admin user id
  reviewerName      String?                      // admin display name
  professionalId    String?                      // REQ 56 — linked Professional created on approval (PRO-xxxxx)
  history           Json                         @default("[]") // decision trail
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt

  @@index([status])
  @@index([phone])
  @@index([createdAt])
  @@index([professionalId]) // REQ 56 — ARQ→PRO traceability
}

model Notification {
  id         String    @id // opaque NT-xxxxx
  userId     String?   // target user
  type       String    @default("system")
  title      String?
  message    String
  entityType String?
  entityId   String?
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([readAt])
}

model LegalDocument {
  id        String   @id // e.g. terms-en | privacy-fr | about-ar
  type      String   // terms | privacy | about
  language  String   // en | fr | ar
  title     String
  content   String
  version   Int      @default(1)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([type, language])
}